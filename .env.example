# Example environment configuration for the building energy HVAC digital twin.
# Copy to .env, fill in your local values, and never commit .env.
# Start the API with:  python -m uvicorn building_hvac_twin.api.main:app --reload --env-file .env

# MongoDB connection (placeholders only; use your own credentials/server).
# Examples:
#   mongodb://localhost:27017
#   mongodb://<username>:<password>@localhost:27017
#   mongodb+srv://<username>:<password>@cluster.example.mongodb.net
MONGODB_URI=mongodb://localhost:27017

# Database name used for application persistence (designs, weather_scenarios,
# predictions, recommendations, comparisons).
MONGODB_DATABASE=building_energy_hvac_twin

# Optional path overrides for the existing project artifacts (defaults are
# resolved against the working directory, then the repository root).
# BHVAC_MODELS_DIR=models/regression
# BHVAC_DATASET_PATH=data/shelter_ml_dataset.csv
# BHVAC_METADATA_PATH=data/shelter_ml_dataset_metadata.json
# BHVAC_METRICS_REPORT=reports/ml_metrics.json
