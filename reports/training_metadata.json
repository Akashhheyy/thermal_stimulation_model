    "provenance": "NASA POWER data are satellite/reanalysis-derived estimates and are not ground measurements."
  },
  "features": {
    "columns": [
      "wall_material",
      "window_wall_orientation",
      "orientation_cardinal",
      "thermal_mass_material",
      "length_m",
      "width_m",
      "height_m",
      "floor_area_m2",
      "volume_m3",
      "wall_insulation_thickness_m",
      "roof_insulation_thickness_m",
      "floor_insulation_thickness_m",
